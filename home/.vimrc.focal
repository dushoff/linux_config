" colo darkblue

com! Sf source ~/.vimrc.focal

nmap @O "cyy:s/^[\s*]*/* /<C-M>
nmap @O "cyy:s/^[* \t]*/* /<C-M>H|" Craziness with \s!
nmap @c "cyyI* <ESC>A …<ESC><C-T>0kJV@k"cP|" Continuing …
nmap @k "cyyI* <ESC><C-T>k0JV@k"cP| " Progress
nmap @K I* <ESC>A ✓<ESC><C-T>kJV@k|" Finished ✓ (and delete)
nmap @k "cyyI* <ESC><C-T>k0JV@k"cP| " Progress
nmap @n I* <ESC>A •<ESC><C-T>kJV@k| " Null task (and delete)
nmap @V @kgV
nmap @w @kgw
nmap @W @kgW

" Move things around index file
vmap gV "wdmn/^## <C-M>{"wP'n
nmap gV VgV
vmap gw "wdmn/^## <C-M>}"wP'n
nmap gw Vgw
vmap gW "wdmn/Su\><C-M>"wkP'n
nmap gW VgW

" nnoremap <silent> gW :let @/='\<Su\>'<Bar>normal! dd<Bar>execute 'normal! ' . v:count1 . 'nP'<CR>

" Why am I having trouble with marks?
" vmaps move the selection (use vip for a ¶); nmaps move the current line
vmap 0D d1GP
vmap 1D d/## Monday/<C-M>}P<C-O><C-O>
vmap 2D d/## Tuesday/<C-M>}P<C-O><C-O>
vmap 3D d/## Wednesday/<C-M>}P<C-O><C-O>
vmap 4D d/## Thursday/<C-M>}P<C-O><C-O>
vmap 5D d/## Friday/<C-M>}P<C-O><C-O>
vmap 6D d/## Saturday/<C-M>}P<C-O><C-O>
vmap 7D d/## Sunday/<C-M>}P<C-O><C-O>
nmap 0D V0D
nmap 1D V1D
nmap 2D V2D
nmap 3D V3D
nmap 4D V4D
nmap 5D V5D
nmap 6D V6D
nmap 7D V7D

nmap 1C @k1D
nmap 2C @k2D
nmap 3C @k3D
nmap 4C @k4D
nmap 5C @k5D
nmap 6C @k6D
nmap 7C @k7D

" @k etc. go V@k → vmap @k (.personal) → @r → gr (buffer 7 = report.md)
" Push a ¶ to the report (and delete)
nmap <C-V> <C-P>@k

" Old ¶-based checklist versions 
" nmap @k }kI* <ESC><C-T>kJV@k
" nmap @K }kI* <ESC>A kk<ESC><C-T>kJV@k
" nmap @C }k"cyyI* <ESC>A …<ESC><C-T>kJV@k"cp

" Date navigation (e-vents)
nmap mE /^202<C-M>H
nmap me /^[0-9][0-9]:[0-9]<C-M>H
" nmap cE ddjI* <ESC>
